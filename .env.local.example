# Copy to .env.local and fill in. Never commit real values.
# See docs/IMPLEMENTATION_PLAN.md §10 and §11.

# --- Supabase (client-safe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SERVER ONLY) ---
# Never prefix with NEXT_PUBLIC_. Used only by src/lib/supabase/admin.ts and scripts/.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ---
NEXT_PUBLIC_PAYMENT_LINK=https://pay.yoco.com/gees-convenience-store

# --- Transactional email (optional in dev; falls back to the dev transport when unset) ---
RESEND_API_KEY=
EMAIL_FROM=GEES <no-reply@example.com>
EMAIL_REPLY_TO=geesconveniencestore01@gmail.com
