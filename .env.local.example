# Copy to .env.local and fill in with real values. Never commit real values.
# Supabase dashboard: Project Settings -> API Keys (and -> Data API for the URL).
# See docs/IMPLEMENTATION_PLAN.md §10 and §11.

# --- Supabase (client-safe; both are exposed to the browser) ---
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Client key: the "publishable key" on newer projects (or the legacy "anon" JWT)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SERVER ONLY — never expose to the browser) ---
# Never prefix with NEXT_PUBLIC_. Used only by src/lib/supabase/admin.ts and scripts/.
# The "secret key" on newer projects (or the legacy "service_role" JWT).
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ---
NEXT_PUBLIC_PAYMENT_LINK=https://pay.yoco.com/gees-convenience-store

# --- Transactional email (optional in dev; falls back to the dev transport when unset) ---
RESEND_API_KEY=
EMAIL_FROM=GEES <no-reply@example.com>
EMAIL_REPLY_TO=geesconveniencestore01@gmail.com
